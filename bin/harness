#!/bin/sh
# Runs one of this harness's skills headless, from any folder:
#   harness [--json] <skill> [arguments...]
# Only a skill marked `headless: true` in its frontmatter runs, with only the
# tools its `allowed-tools` line names, and every one of those has to be in
# bin/harness-tools. The session starts at the harness root, so the rules,
# skills and guards load as they do in a normal session.
# From the Sanvio Labs harness starter, MIT: https://github.com/SanvioLabs/sanvio-harness-starter

root=$(cd "$(dirname "$0")/.." && pwd) || exit 2
cd "$root" || exit 2

refuse() {
  echo "harness: $*" >&2
  exit 2
}

json=
if [ "$1" = "--json" ]; then
  json=1
  shift
fi

name=$1
case $name in
  '') refuse "usage: harness [--json] <skill> [arguments...]" ;;
  -* | *[!a-z0-9-]*) refuse "'$name' isn't a skill name: lowercase letters, digits and dashes only" ;;
esac
skill="skills/$name/SKILL.md"
[ -f "$skill" ] || refuse "no skill called '$name' in $root/skills"
shift

# The frontmatter: the lines between a first line that is exactly --- and the next one.
front=$(awk 'NR == 1 { if ($0 != "---") exit; next } $0 == "---" { exit } { print }' "$skill")
count() { printf '%s\n' "$front" | grep -c "^$1:"; }
[ "$(count headless)" -le 1 ] && [ "$(count allowed-tools)" -le 1 ] \
  || refuse "$name sets headless or allowed-tools more than once"
printf '%s\n' "$front" | grep -Eqx 'headless:[[:space:]]*true[[:space:]]*' \
  || refuse "$name isn't marked headless: true, so it only runs in a session"
tools=$(printf '%s\n' "$front" | sed -n 's/^allowed-tools:[[:space:]]*//p' | sed 's/[[:space:]]*$//')
case $tools in
  '') refuse "$name is headless but names no allowed-tools" ;;
  '>'* | '|'* | '['*) refuse "$name's allowed-tools has to be one comma-separated line" ;;
esac

# Every entry has to be one of bin/harness-tools' lines, and the tools themselves go to --tools too.
approved=$(grep -v '^#' bin/harness-tools)
names=
old_ifs=$IFS
IFS=,
for entry in $tools; do
  entry=$(printf '%s' "$entry" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  printf '%s\n' "$approved" | grep -Fqx -- "$entry" || refuse "$name lists '$entry', which bin/harness-tools doesn't approve"
  tool=${entry%%(*}
  case ",$names," in *",$tool,"*) ;; *) names=${names:+$names,}$tool ;; esac
done
IFS=$old_ifs

prompt="/$name"
if [ $# -gt 0 ]; then
  prompt="$prompt $*"
fi

# The mode and the tools are set here, so nothing in a person's own settings widens a run nobody watches.
# --allowedTools takes a list, so it goes last, where nothing after it can be read as one of its tools.
if [ -n "$json" ]; then
  set -- -p "$prompt" --output-format json --permission-mode default --tools "$names" --allowedTools "$tools"
else
  set -- -p "$prompt" --permission-mode default --tools "$names" --allowedTools "$tools"
fi
HARNESS_HEADLESS=1
export HARNESS_HEADLESS
exec claude "$@"
